// Простое присвоение
const x = value;

// Типизированное присвоение
const x: Type = value;

// Объявление переменной с типом и без значения
let x: Type;

// Объявление переменной с типом и присвоение ей значения с явным приведением типов
let x: Type;
x = value as Type;

// Ссылка: вместо хранения скопированного значения константы «x» мы сохраняем ссылку на значение константы
const x = value;
const y = &x;

/** Deffered
	* Ключевое слово обозначающее отложенную инициализацию
	* Позволяет реализовать доступ к полям внутри ключей одного объекта
	*
	* Значение для deffered объявлений будет присвоено после того, как остальной объект будет инициализирован
	* При этом перекрёстные deffered будут обработаны в зависимости от последовательности
	* Если один deffered ссылается на другой, то он принудительно будет просчитан только после инициализации
	* deffered на который тот ссылается
	*/
const x: Dictionary<String, UInt32> = {
  a: 100
  b: 1000
	// x.c === 1100
  deferred c: root.a + root.b
	// перекрнёстный deferred: x.d === 11 000
	deferred d: root.c * (root.a // root.b)
}

// Сокращённая форма объявлений: массивы ключей
const x: ... = {
	[a, b]: [100, 100]
	/** Scope: не обязательно писать root для обращения к полям того же объекта
	* Scope: global -> local -> root
	* Интерпретатор автоматически использует наиболее локальное объявление, если то существует
	*/
	deferred [c, d]: [a + b, c * (a // b)]
}

// Деструктуризация
const y: Dictionary<String, UInt32>[] = {
	[{...x}]
	[x]
	[{ a: 1_000_000 }]
}

/** Reactive
	* Ключевое слово объявляющее реактивное значение
	* При изменении зависимых данных реактивное поле автоматичеси будет изменено
	*
	* Computed
	* Ключевое слово для вычисляемого значения, поддерживающего реактивность
	*/
const r: ... = {
	reactive [a, b]: [100, 1000]
	computed deferred c: a + b // === 11000
}
r.a = 1000 as Int32;
// r.x теперь равен 2000, 1000 (a) + 1000 (b)

// Объявление реактивным только r.a
const r: ... = {
	[reactive a, b]: [100, 1000]
	computed deferred c: a + b
}
